{
  "id": "ollama",
  "kind": "plugin",
  "version": "1.0.42",
  "label": "Ollama",
  "description": "Local Ollama gateway for Settings \u2192 LLMs. Point at your Ollama server URL (default http://localhost:11434). Install from Store \u2192 Gateways, then enable to show the Ollama row under Providers & Keys.",
  "min_app_version": "1.2.160",
  "default_enabled": true,
  "secret_keys": [
    "ollama"
  ],
  "contributes": {
    "agent.tools": {
      "category": "ollama",
      "intent_pattern": "\\b(ollama|local model|num_ctx|vram)\\b"
    },
    "shell.boot": [
      {
        "entry": "ui/boot.js"
      }
    ],
    "ui.panels": [
      {
        "id": "ollama-live",
        "title": "Ollama",
        "icon": "assets/icon.png",
        "entry": "ui/live.html"
      }
    ],
    "dock.panels": [
      {
        "id": "ollama-live",
        "title": "Ollama",
        "defaultSide": "left",
        "ui": "panel:ollama-live"
      }
    ],
    "llm.providers": [
      {
        "id": "ollama",
        "label": "Ollama",
        "kind": "url",
        "secret_key": "ollama",
        "default_url": "http://localhost:11434",
        "order": 100
      }
    ],
    "walkthrough": {
      "id": "ollama",
      "title": "Set up Ollama",
      "auto_start": "first_enable",
      "settings_tab": "LLMs",
      "steps": [
        {
          "target": "settings.llms.provider.ollama",
          "title": "Open Ollama",
          "body": "Press the Ollama row in this table. The page slides open so you can set the server URL.",
          "advance": "require_click",
          "mode": "rect"
        },
        {
          "target": "settings.llms.provider.key",
          "title": "Ollama URL",
          "body": "Leave the default http://localhost:11434 or paste your Ollama server URL.",
          "advance": "next",
          "mode": "rect"
        },
        {
          "target": "settings.llms.provider.save",
          "title": "Test & Save",
          "body": "Press Test & Save to confirm Ollama is reachable.",
          "advance": "require_click",
          "mode": "rect"
        },
        {
          "target": "settings.llms.back",
          "title": "Back",
          "body": "Press Back to return to the provider list.",
          "advance": "require_click",
          "mode": "rect"
        }
      ]
    },
    "automations": {
      "nodes": [
        {
          "id": "ollama.complete",
          "label": "Ollama complete",
          "group": "Ollama",
          "description": "One-shot prompt through the Ollama gateway. Writes text onto the run.",
          "config_fields": [
            {
              "id": "prompt",
              "label": "Prompt",
              "type": "textarea"
            },
            {
              "id": "model",
              "label": "Model",
              "type": "model",
              "provider": "ollama"
            }
          ]
        }
      ],
      "templates": [
        {
          "id": "ollama-complete",
          "label": "Ollama complete",
          "icon": "\u2728",
          "systems": [
            "pipeline"
          ],
          "description": "Chat prompt through Ollama, then finish.",
          "graph": {
            "nodes": [
              {
                "id": "s",
                "type": "start.chat",
                "x": 40,
                "y": 80,
                "config": {},
                "label": "Chat",
                "description": ""
              },
              {
                "id": "c",
                "type": "ollama.complete",
                "x": 280,
                "y": 80,
                "config": {},
                "label": "Complete",
                "description": ""
              },
              {
                "id": "f",
                "type": "pipeline.finish",
                "x": 520,
                "y": 80,
                "config": {},
                "label": "Finish",
                "description": ""
              }
            ],
            "edges": [
              {
                "source": "s",
                "target": "c",
                "kind": "main"
              },
              {
                "source": "c",
                "target": "f",
                "kind": "main"
              }
            ]
          }
        }
      ]
    }
  },
  "backend": {
    "entry": "backend",
    "register": "register"
  }
}
